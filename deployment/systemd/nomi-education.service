[Unit]
Description=Nomi Education Management System
Requires=postgresql.service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nomi-education/Nomi
EnvironmentFile=/opt/nomi-education/Nomi/.env.production

# Start containers using podman-compose
ExecStart=/usr/bin/podman-compose -f /opt/nomi-education/Nomi/docker-compose.production.yml up -d

# Stop containers
ExecStop=/usr/bin/podman-compose -f /opt/nomi-education/Nomi/docker-compose.production.yml down

# Restart policy
Restart=on-failure
RestartSec=10s

# Security settings
User=nomi
Group=nomi

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nomi-education

[Install]
WantedBy=multi-user.target
