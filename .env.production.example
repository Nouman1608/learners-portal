# Production Environment Configuration for Nomi Education System
# Copy this file to .env.production and fill in the actual values
# NEVER commit .env.production to version control

# ============================================
# Database Configuration
# ============================================
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_HERE
POSTGRES_DB=nomi_education

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
PORT=5000

# Frontend and Backend URLs (replace with your domain)
FRONTEND_URL=https://nomi.yourdomain.com
BACKEND_URL=https://nomi.yourdomain.com/api
VITE_API_URL=https://nomi.yourdomain.com/api

# ============================================
# JWT Secrets (Generate using: openssl rand -hex 64)
# ============================================
JWT_SECRET=YOUR_VERY_LONG_RANDOM_JWT_SECRET_HERE_64_CHARS_MINIMUM
JWT_REFRESH_SECRET=YOUR_VERY_LONG_RANDOM_REFRESH_SECRET_HERE_64_CHARS_MINIMUM

# ============================================
# Encryption Key (Generate using: openssl rand -hex 32)
# ============================================
ENCRYPTION_KEY=YOUR_32_BYTE_HEX_ENCRYPTION_KEY_HERE

# ============================================
# Microsoft Teams OAuth Configuration
# ============================================
# Get these from Azure Portal > App registrations
MICROSOFT_CLIENT_ID=YOUR_AZURE_APP_CLIENT_ID_HERE
MICROSOFT_CLIENT_SECRET=YOUR_AZURE_APP_CLIENT_SECRET_VALUE_HERE
MICROSOFT_TENANT_ID=YOUR_AZURE_TENANT_ID_HERE

# ============================================
# Email Configuration (SMTP)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=Nomi Education <noreply@yourdomain.com>

# ============================================
# Optional: Additional Configuration
# ============================================
# TZ=Asia/Karachi  # Set timezone for cron jobs
# LOG_LEVEL=info
# MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
